<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Nombre del cliente -->
    <TextView
        android:id="@+id/tvNombreCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Apellidos del cliente -->
    <TextView
        android:id="@+id/tvApellidosCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- DNI del cliente -->
    <TextView
        android:id="@+id/tvDniCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- Botón papelera, mismo patrón que item_admin -->
    <ImageButton
    android:id="@+id/btnEliminarCliente"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_gravity="center"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:src="@drawable/ic_delete"
    app:tint="#D5042E" />

    <!-- Spinner individual de fila, visible solo mientras se procesa el borrado -->
    <ProgressBar
        android:id="@+id/progressEliminarCliente"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/background"
        android:visibility="gone" />

</LinearLayout>